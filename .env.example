# URLs de la API (sin barra final). Copiá a `.env` y ajustá.
# `.env` no se versiona.

# PC / web
EXPO_PUBLIC_API_URL=http://localhost:3000

# Emulador Android (10.0.2.2 = localhost de la PC)
EXPO_PUBLIC_API_URL_EMULADOR=http://10.0.2.2:3000

# Teléfono físico: IP de la PC en el Wi-Fi (ipconfig / ifconfig)
EXPO_PUBLIC_API_URL_TELEFONO=http://192.168.1.10:3000
